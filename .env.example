PORT=3000
HOST=0.0.0.0
# Number of reverse proxies in front of Node (nginx, Caddy, Cloudflare...). 0 = none.
TRUST_PROXY=0
# Requests allowed per IP per minute.
RATE_LIMIT_MAX=240
# Comma separated hostnames this site answers to (empty = any). Example: batuhancakmak.dev,www.batuhancakmak.dev
ALLOWED_HOSTS=
